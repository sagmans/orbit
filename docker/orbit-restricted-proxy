#!/bin/sh
set -eu
: "${ORBIT_ALLOWED_DOMAINS:?ORBIT_ALLOWED_DOMAINS required}"
allow_file=/etc/squid/orbit-allowed-domains.txt
: > "$allow_file"
IFS=','
# Squid dstdomain .domain entries match exact hosts and subdomains. Do not emit
# both domain and .domain: Squid rejects parent/subdomain duplicates in one ACL.
for domain in $ORBIT_ALLOWED_DOMAINS; do
  [ -n "$domain" ] || continue
  case "$domain" in
    .*) printf '%s\n' "$domain" >> "$allow_file" ;;
    *) printf '.%s\n' "$domain" >> "$allow_file" ;;
  esac
done
cat > /etc/squid/squid.conf <<SQUID
http_port 127.0.0.1:18080
acl orbit_allowed dstdomain "$allow_file"
http_access allow orbit_allowed
http_access deny all
access_log none
cache_log /dev/stderr
cache deny all
cache_effective_user squid
SQUID
if [ -n "${ORBIT_UPSTREAM_PROXY_FILE:-}" ]; then
  ORBIT_UPSTREAM_PROXY="$(cat "$ORBIT_UPSTREAM_PROXY_FILE")"
fi
if [ -n "${ORBIT_UPSTREAM_PROXY:-}" ]; then
  proxy_no_scheme=${ORBIT_UPSTREAM_PROXY#*://}
  proxy_hostport=${proxy_no_scheme#*@}
  case "$proxy_hostport" in
    *:*)
      proxy_host=${proxy_hostport%:*}
      proxy_port=${proxy_hostport##*:}
      ;;
    *)
      proxy_host=$proxy_hostport
      proxy_port=3128
      ;;
  esac
  if [ "$proxy_no_scheme" != "$proxy_hostport" ]; then
    proxy_creds=${proxy_no_scheme%@*}
    printf 'cache_peer %s parent %s 0 no-query default login=%s\n' "$proxy_host" "$proxy_port" "$proxy_creds" >> /etc/squid/squid.conf
  else
    printf 'cache_peer %s parent %s 0 no-query default\n' "$proxy_host" "$proxy_port" >> /etc/squid/squid.conf
  fi
  printf 'never_direct allow all\n' >> /etc/squid/squid.conf
fi
# Default-deny direct egress for application containers sharing this network namespace.
iptables -w -F OUTPUT
iptables -w -P OUTPUT DROP
iptables -w -A OUTPUT -o lo -j ACCEPT
iptables -w -A OUTPUT -m owner --uid-owner squid -j ACCEPT
iptables -w -A OUTPUT -j REJECT
if [ -r /proc/net/if_inet6 ] && grep -vq ' lo$' /proc/net/if_inet6; then
  ip6tables -w -F OUTPUT
  ip6tables -w -P OUTPUT DROP
  ip6tables -w -A OUTPUT -o lo -j ACCEPT
  ip6tables -w -A OUTPUT -m owner --uid-owner squid -j ACCEPT
  ip6tables -w -A OUTPUT -j REJECT
fi
exec squid -N -f /etc/squid/squid.conf
